# Set these on the backend only. Do not use NEXT_PUBLIC_ for provider keys.
QUIVER_API_KEY=
NANSEN_API_KEY=
# Required on Fly; also configure the same API_SECRET on the Next server.
API_SECRET=
POLYGON_API_KEY=
# Identify your operator/contact to the SEC; never use a fictional email.
EDGAR_USER_AGENT=

# Legacy positions use unreconciled prices; automatic opening/closing stays off by default.
ENABLE_LEGACY_PAPER_ALLOCATION=0
